": 20000.0, "url_txt": "https://www.cian.ru/rent/commercial/315718395/", "year_built": "2013", "ad_dttm": "2025-11-18T06:55:13", "create_dttm": "2025-04-01T18:28:22.863", "city_nm": "г Мытищи", "latitude": "55.912084", "longitude": "37.610274"}
