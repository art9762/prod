 под сортировочный центр с пунктом выдачи. Спортивным центрам промышленного формата и многим другим.", "price_amt": "3153760000", "sq_price_amt": 160000.0, "url_txt": "https://www.cian.ru/sale/commercial/320964868/", "year_built": "2026", "ad_dttm": "2025-11-18T16:42:16", "create_dttm": "2025-08-19T18:01:18.68", "city_nm": "г Москва", "latitude": "55.3942981", "longitude": "37.4316895"}
