commercial/324034281/", "year_built": "2012", "ad_dttm": "2025-11-18T09:14:33", "create_dttm": "2025-11-17T16:24:58.093", "city_nm": "г Лобня", "latitude": "56.0195366", "longitude": "37.4667601"}
