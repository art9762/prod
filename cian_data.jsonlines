ear_built": "", "ad_dttm": "2025-11-18T15:03:18", "create_dttm": "2023-01-11T12:35:23.24", "city_nm": "г Санкт-Петербург", "latitude": "59.9304809", "longitude": "30.3553163"}
{"ad_id": "300737615", "type_nm": "sale", "category_nm": "buildingSale", "title": "Здание  •  26 000 м²  •  4 этажа", "full_address_txt": "Россия, Московская область, Долгопрудный, Лихачёвский проспект, 74", "total_area": "26000.0", "floor_no": "0", "desc_txt": "ТЦ Город - торговый центр общей площадью 26 000 м2, расположенный в микрорайоне Центральный на главной магистрали Долгопрудного, МО (130 000 жителей) - самый крупный и современный ТЦ города.\n    Расположение ТЦ предполагает шаговую доступность для жителей самого густонаселенного района города, удобные транспортные маршруты.\n    Концепция объекта включает 3 этажа и 14 000 м2 торговой площади, на которых располагаются магазины известных брендов:\n- супермаркет Перекресток\n- Детский мир\n- Эльдорадо (техника и электроника)\n- Zolla, FUN DAY, Сударь (одежда)\n- Спортмастер (спорттовары)\n- Salamander, Тофа (обувь)\n- Порядок (супермаркет товаров для дома и сада)\n- Четыре Лапы (зоотовары)\n- Офисмаг (скоро открытие)\n- Котофей\nСфера питания представлена ресторанами Вкусно и точка, Тануки, Теремок, Burger Club, Pho Street и др.\nСамый большой фудкорт в городе.\n\nНаземный и подземный паркинг более чем на 440 машиномест.\n\nЛучший объект на рынке, продуманное зонирование, заполнен на 100%, отличное состояние всех коммуникаций, собственная УК.\n\nПродажа 100% доли в ООО", "price_amt": "1950000000", "sq_price_amt": 75000.0, "url_txt": "https://www.cian.ru/sale/commercial/300737615/", "year_built": "2019", "ad_dttm": "2025-10-24T12:40:52", "create_dttm": "2024-04-12T14:35:55.13", "city_nm": "г Долгопрудный", "latitude": "55.9362104", "longitude": "37.4929665"}
