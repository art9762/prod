ам с прямыми продажами (с организацией шоу-рума/магазина). Крупным сетевым магазинам. Логистическим компаниям под сортировочный центр с пунктом выдачи.", "price_amt": "1612000000", "sq_price_amt": 160000.0, "url_txt": "https://www.cian.ru/sale/commercial/320964870/", "year_built": "2026", "ad_dttm": "2025-11-18T16:42:19", "create_dttm": "2025-08-19T18:01:20.997", "city_nm": "г Москва", "latitude": "55.3942981", "longitude": "37.4316895"}
