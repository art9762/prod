кв/месяц с НДС", "price_amt": "5271740", "sq_price_amt": 20160.0, "url_txt": "https://www.cian.ru/rent/commercial/323595509/", "year_built": "2024", "ad_dttm": "2025-11-18T09:47:47", "create_dttm": "2025-11-05T12:26:56.36", "city_nm": "г Подольск", "latitude": "55.3805664", "longitude": "37.5986296"}
