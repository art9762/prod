а на территорию комплекса \n\nЦена: Арендная ставка за м2 варьируется от назначения помещения от 500-750 руб/мес. Общая ежемесячно 5 350 000 руб.", "price_amt": "5350000", "sq_price_amt": 6420.0, "url_txt": "https://www.cian.ru/rent/commercial/323133045/", "year_built": "", "ad_dttm": "2025-11-05T14:09:01", "create_dttm": "2025-10-21T18:27:52.063", "city_nm": "г Ростов-на-Дону", "latitude": "47.28735", "longitude": "39.806371"}
