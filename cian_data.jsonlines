й информации и организации просмотра!", "price_amt": "6072000", "sq_price_amt": 31998.0, "url_txt": "https://www.cian.ru/rent/commercial/319315430/", "year_built": "1939", "ad_dttm": "2025-11-05T02:50:32", "create_dttm": "2025-07-01T16:35:34.18", "city_nm": "г Москва", "latitude": "55.7450426", "longitude": "37.7133567"}
