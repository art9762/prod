начение: Склад\n    Свободная площадь: 5 000 м2;\n    Температурный режим: Теплый;\n    Этаж: 1;\n    Высота потолка: 12 м;\n    Пол: Бетон-антипыль;\n\nКоммерческие условия:\n    Арендная ставка: 1 225 руб/м.кв/месяц с НДС", "price_amt": "6125000", "sq_price_amt": 14700.0, "url_txt": "https://www.cian.ru/rent/commercial/323806293/", "year_built": "", "ad_dttm": "2025-11-18T09:37:01", "create_dttm": "2025-11-11T16:34:07.85", "city_nm": "г Солнечногорск", "latitude": "56.073891", "longitude": "37.125451"}
