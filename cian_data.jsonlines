дборку объектов.", "price_amt": "25756500", "sq_price_amt": 66000.0, "url_txt": "https://www.cian.ru/rent/commercial/321166005/", "year_built": "2008", "ad_dttm": "2025-11-18T15:35:39", "create_dttm": "2025-08-26T12:16:15.72", "city_nm": "г Москва", "latitude": "55.7518793", "longitude": "37.5327222"}
