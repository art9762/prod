ая ставка за офис - 13500 руб. кв. м. (без учета НДС) /год;\n\n- Коммунальные платежи оплачиваются отдельно", "price_amt": "6046200", "sq_price_amt": 10800.0, "url_txt": "https://www.cian.ru/rent/commercial/322193218/", "year_built": "", "ad_dttm": "2025-11-17T16:10:48", "create_dttm": "2025-09-24T14:15:58.997", "city_nm": "г Обь", "latitude": "55.000043", "longitude": "82.65354"}
