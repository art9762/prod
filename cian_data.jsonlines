9.0, "url_txt": "https://www.cian.ru/sale/commercial/318470552/", "year_built": "1880", "ad_dttm": "2025-11-17T16:55:17", "create_dttm": "2025-06-06T15:17:12.16", "city_nm": "г Москва", "latitude": "55.7702299", "longitude": "37.5970495"}
