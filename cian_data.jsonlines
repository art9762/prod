сирования.\n\nДополнительная информация и презентация  по запросу.\n\nЗвоните  обсудим задачи вашего бизнеса и подберем идеальное решение!", "price_amt": "610169760", "sq_price_amt": 126960.0, "url_txt": "https://www.cian.ru/sale/commercial/320029013/", "year_built": "", "ad_dttm": "2025-11-18T14:10:38", "create_dttm": "2025-07-22T18:00:08.413", "city_nm": "г Щербинка", "latitude": "55.493408", "longitude": "37.562269"}
