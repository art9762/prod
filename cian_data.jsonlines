е: 754", "price_amt": "3900000", "sq_price_amt": 11349.0, "url_txt": "https://www.cian.ru/rent/commercial/323019885/", "year_built": "2012", "ad_dttm": "2025-11-17T18:08:26", "create_dttm": "2025-10-17T18:50:35.743", "city_nm": "г Екатеринбург", "latitude": "56.862632", "longitude": "60.634081"}
