ce_amt": "22400000", "sq_price_amt": 4800.0, "url_txt": "https://www.cian.ru/rent/commercial/320591877/", "year_built": "", "ad_dttm": "2025-11-18T19:04:26", "create_dttm": "2025-08-07T16:32:56.283", "city_nm": "г Москва", "latitude": "55.4565045", "longitude": "36.9382874"}
