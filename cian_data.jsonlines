36.0, "url_txt": "https://www.cian.ru/sale/commercial/323248409/", "year_built": "2024", "ad_dttm": "2025-11-18T07:55:32", "create_dttm": "2025-10-24T18:59:31.78", "city_nm": "г Москва", "latitude": "55.791703", "longitude": "37.472941"}
