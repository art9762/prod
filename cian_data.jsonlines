/месяц с НДС", "price_amt": "24000000", "sq_price_amt": 4800.0, "url_txt": "https://www.cian.ru/rent/commercial/317196136/", "year_built": "", "ad_dttm": "2025-11-18T19:01:12", "create_dttm": "2025-05-06T13:05:48.59", "city_nm": "г Москва", "latitude": "55.4565045", "longitude": "36.9382874"}
