. Стоимость ответственного хранения определяется фактически занимаемой площадью под груз (товар).\n\n\nКоммерческие условия:\n    Цена за паллетоместо: 42 руб.;", "price_amt": "5040000", "sq_price_amt": 15120.0, "url_txt": "https://www.cian.ru/rent/commercial/320960118/", "year_built": "", "ad_dttm": "2025-11-18T09:26:49", "create_dttm": "2025-08-19T16:10:54.323", "city_nm": "г Химки", "latitude": "55.9900968", "longitude": "37.4125959"}
