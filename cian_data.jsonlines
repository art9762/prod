{"ad_id": "277996512", "type_nm": "sale", "category_nm": "buildingSale", "title": "Здание  •  10 113 м²  •  4 этажа", "full_address_txt": "Россия, Москва, улица Космонавта Волкова, 31", "total_area": "10113.0", "floor_no": "0", "desc_txt": "Продажа от СОБСТВЕННИКА (продажа доли в компании) здания на Космонавта Волкова 31: в САО, на Ленинградском шоссе, офисный центр, имеет отличную транспортную доступность, расположен через дорогу от станции Красный Балтиец МЦД в 15 минутах пешей доступности от станции м. Войковская или Сокол, в десяти минутах езды от ТТК. Евроремонт, приточно-вытяжная вентиляция, кондиционирование, огороженная территория, охрана, парковка, интернет, телефон, кафе, полная инфраструктура. Продажа 100% доли в компании, без НДС.", "price_amt": "1800000000", "sq_price_amt": 177989.0, "url_txt": "https://www.cian.ru/sale/commercial/277996512/", "year_built": "", "ad_dttm": "2025-10-26T10:21:06", "create_dttm": "2022-09-07T13:59:36.313", "city_nm": "г Москва", "latitude": "55.817078", "longitude": "37.5264427"}
