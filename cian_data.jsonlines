65042.0, "url_txt": "https://www.cian.ru/rent/commercial/322358363/", "year_built": "2004", "ad_dttm": "2025-11-18T11:11:15", "create_dttm": "2025-09-29T16:25:51.667", "city_nm": "г Москва", "latitude": "55.795585", "longitude": "37.541099"}
