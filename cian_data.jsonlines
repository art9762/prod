тр или подготовим подборку объектов.", "price_amt": "5296000", "sq_price_amt": 48000.0, "url_txt": "https://www.cian.ru/rent/commercial/321166450/", "year_built": "2025", "ad_dttm": "2025-11-18T17:59:40", "create_dttm": "2025-08-26T12:22:52.457", "city_nm": "г Москва", "latitude": "55.7219191", "longitude": "37.6461928"}
