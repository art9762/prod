снащение, соответствующие стандартам торговых центров.", "price_amt": "1500000000", "sq_price_amt": 250000.0, "url_txt": "https://www.cian.ru/sale/commercial/323127217/", "year_built": "1978", "ad_dttm": "2025-10-28T05:27:55", "create_dttm": "2025-10-21T16:28:52.903", "city_nm": "г Москва", "latitude": "55.8223931", "longitude": "37.8233013"}
