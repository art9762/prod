amt": "4194816", "sq_price_amt": 23040.0, "url_txt": "https://www.cian.ru/rent/commercial/321740894/", "year_built": "", "ad_dttm": "2025-11-17T08:05:25", "create_dttm": "2025-09-11T14:43:02.273", "city_nm": "г Апрелевка", "latitude": "55.5509513", "longitude": "37.0619657"}
