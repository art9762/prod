есто: 42 руб.;", "price_amt": "5040000", "sq_price_amt": 15120.0, "url_txt": "https://www.cian.ru/rent/commercial/318565145/", "year_built": "", "ad_dttm": "2025-11-18T09:20:48", "create_dttm": "2025-06-09T17:40:41.523", "city_nm": "г Подольск", "latitude": "55.3305858", "longitude": "37.5267894"}
