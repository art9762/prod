капитализации с открытием метро\n• Возможность сдачи по блокам или этажом целиком\n• ROI: 9-12%\n________________________________________\nАдрес объекта: МКАД, 64 км", "price_amt": "473074893", "sq_price_amt": 316477.0, "url_txt": "https://www.cian.ru/sale/commercial/320705885/", "year_built": "2025", "ad_dttm": "2025-11-18T13:40:57", "create_dttm": "2025-08-11T19:51:16.767", "city_nm": "г Москва", "latitude": "55.7925982", "longitude": "37.3774934"}
