с.", "price_amt": "2200000000", "sq_price_amt": 81482.0, "url_txt": "https://www.cian.ru/sale/commercial/311341222/", "year_built": "", "ad_dttm": "2025-11-17T17:40:30", "create_dttm": "2024-12-16T17:01:21.323", "city_nm": "г Чехов", "latitude": "55.2530902", "longitude": "37.484123"}
