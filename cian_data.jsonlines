an.ru/sale/commercial/304780335/", "year_built": "", "ad_dttm": "2025-11-17T16:55:15", "create_dttm": "2024-07-17T13:43:30.76", "city_nm": "г Домодедово", "latitude": "55.4477983", "longitude": "37.6759198"}
