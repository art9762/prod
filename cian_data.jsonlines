сделку.", "price_amt": "500000000", "sq_price_amt": 1457726.0, "url_txt": "https://www.cian.ru/sale/commercial/322625456/", "year_built": "", "ad_dttm": "2025-11-18T00:40:19", "create_dttm": "2025-10-07T01:24:49.743", "city_nm": "г Лаишево", "latitude": "55.4044003", "longitude": "49.5499442"}
