разующие Арендаторы: супермаркет \"СВЕТОФОР\", магазин \"БРИСТОЛЬ\", автосервис \"Масломарт\".", "price_amt": "490000000", "sq_price_amt": 26843.0, "url_txt": "https://www.cian.ru/sale/commercial/313997902/", "year_built": "2000", "ad_dttm": "2025-11-17T10:40:44", "create_dttm": "2025-02-21T13:48:57.43", "city_nm": "г Тюмень", "latitude": "57.1195107", "longitude": "65.5744701"}
