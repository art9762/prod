в ЦАО, аренда здания, аренда офиса, офис Бауманская, ПСН Бауманская, арендовать помещение в Москве, помещение под коворкинг, офисы в аренду", "price_amt": "3980510", "sq_price_amt": 51600.0, "url_txt": "https://www.cian.ru/rent/commercial/323094321/", "year_built": "", "ad_dttm": "2025-10-23T16:17:47", "create_dttm": "2025-10-20T19:14:45.463", "city_nm": "г Москва", "latitude": "55.7663954", "longitude": "37.6783291"}
