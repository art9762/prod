лужский\";\n- Гастромаркет \"Рынок на Ленинском\";\n- Офисы крупных нефтегазовых компаний и научно-исследовательские институты.", "price_amt": "623225218", "sq_price_amt": 459098.0, "url_txt": "https://www.cian.ru/sale/commercial/323213645/", "year_built": "2026", "ad_dttm": "2025-11-18T14:00:28", "create_dttm": "2025-10-24T01:48:02.49", "city_nm": "г Москва", "latitude": "55.660408", "longitude": "37.535614"}
