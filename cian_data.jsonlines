: 78000.0, "url_txt": "https://www.cian.ru/rent/commercial/322670040/", "year_built": "", "ad_dttm": "2025-11-17T12:55:47", "create_dttm": "2025-10-08T07:44:54.523", "city_nm": "г Москва", "latitude": "55.7848384", "longitude": "37.5860924"}
